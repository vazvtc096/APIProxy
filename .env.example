# ============================================================================
# APIProxy 环境变量示例
# 使用：cp .env.example .env  然后填写真实值
# ============================================================================

# ---- 必填：OAuth JWT 签名密钥（fail-closed，缺失拒绝启动）----
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
APIPROXY_OAUTH_JWT_SECRET=

# ---- 上游 API Key（按 upstream 名称注入）----
# 名称 deepseek-main → 变量 APIPROXY_UPSTREAM_DEEPSEEK_MAIN_API_KEY
APIPROXY_UPSTREAM_DEEPSEEK_MAIN_API_KEY=

# ---- 可选：SMTP（邮箱验证 / 找回密码）----
# SMTP_USER=
# SMTP_PASS=

# ---- 可选：HTTPS ----
# APIPROXY_SSL_ENABLED=true
# APIPROXY_HTTPS_PORT=5443

# ---- 可选：数据库后端 ----
# DB_TYPE=sqlite           # 默认，SQLite（数据存 /data/users.db）
# DB_TYPE=postgres         # PostgreSQL，需同时设 DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- 可选：Redis（限流/会话缓存加速）----
# REDIS_URL=redis://redis:6379/0

# ---- 可选：分布式集群（服务发现 + 智能路由）----
# CLUSTER_ENABLED=true
# CLUSTER_ROLE=lb            # lb=负载均衡器（对外固定端口）/ worker=服务端（随机端口）
# CLUSTER_TRANSPORT=multicast # multicast=组播（同网段）/ tcp=单播注册中心（跨网段）
# CLUSTER_LB_PORT=8000       # LB 对外固定端口
# CLUSTER_GROUP=239.255.0.1  # 组播地址（multicast 传输）
# CLUSTER_PORT=5005          # 组播端口（multicast 传输）
# CLUSTER_TCP_PORT=5006      # TCP 注册端口（tcp 传输，LB 监听）
# CLUSTER_LB_HOST=           # Worker 连接 LB 的地址（tcp 传输，留空则取本机 IP）
# CLUSTER_VNET=false         # 虚拟网络模式（VirtualRouter 模拟跨网段，tcp 传输走 WrappedSocket）
# CLUSTER_WORKER_TIMEOUT=180 # Worker 未发现 LB 自动关闭秒数
# CLUSTER_NODE_PORT=0        # Worker 服务端口（0=随机）

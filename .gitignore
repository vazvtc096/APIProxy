# ============================================================================
# APIProxy .gitignore
# ============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.dll
*.dylib
*.egg
*.egg-info/
dist/
build/
.eggs/

# --- 虚拟环境 ---
venv/
.venv/
env/
ENV/

# --- 数据库 ---
*.db
*.db-journal
*.db-wal
*.db-shm

# --- 密钥与敏感文件 ---
.session_secret
.debug_console_key
# 单实例锁：运行期由 instance_lock.py 生成（含持有者 PID），不入库
.apiproxy.lock
*.pem
*.key
*.crt
*.cer
*.csr
.env
.env.*
!.env.example

# --- 配置文件（含密钥，不提交；仅模板入库） ---
config.yaml
config.yml
config.json
config.toml
!config.yaml.example
!config.example.yaml

# --- 日志 ---
*.log
*.log.*
service.out.log
service.err.log
cloudflared.log

# --- IDE / 编辑器 ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docker ---
docker-compose.override.yml

# --- 测试 / 覆盖率 ---
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- 其他 ---
*.bak
*.tmp
*.cache

# --- 全量备份快照（git 已有历史，无需纳入版本库）---
archive/
*.tar.gz
*.tar

# --- 调试/临时与项目运行数据（非源码，不纳入版本库）---
.workbuddy/
backups/
users.db*
java/target/
java/.maven/
*.selfsigned-bak
# 根目录与子目录下的一次性调试脚本/日志
#（前导 / 限定目录，避免误伤子包 __init__.py 与正式模块如 routes/_gemini_translate.py）
/_*.txt
/_*.py
/.dbg_*.py
/tests/_*.py
/templates/_*.py
seq_anomaly.json
/audit_exports/
login_screenshot.png
*.png
*.jpg
*.jpeg
*.gif
